---
# Copier en vars/all.yml puis renseigner.
#
#   cp ansible/vars/all.yml.example ansible/vars/all.yml
#   ansible-playbook -i inventory/local.ini site.yml -e @vars/all.yml

# Cle publique autorisee sur le compte d'administration. Obligatoire :
# sans elle le playbook refuse de demarrer, car il coupe l'authentification
# par mot de passe.
admin_ssh_key: "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... vous@votre-poste"

# Surcharges facultatives des valeurs de group_vars/all.yml
# admin_user: deploy
# ssh_port: 2222
# firewall_allowed_tcp_ports:
#   - 80
#   - 443
# timezone: Europe/Paris
